# Keep /api/early-access to store entries in the built-in signup list.
# A custom destination must accept a JSON POST with firstName, email,
# and optional whatsappNumber, and allow requests from this site's origin.
VITE_SIGNUP_DESTINATION=/api/early-access

# Set after the site has a real public origin; build uses it for canonical,
# Open Graph, robots.txt, and sitemap URLs. Leave blank during development.
VITE_PUBLIC_URL=
